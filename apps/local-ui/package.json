{
  "name": "cipherwhisper-local-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/notices.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "format": "prettier --write src tests scripts *.ts *.js *.json index.html",
    "format:check": "prettier --check src tests scripts *.ts *.js *.json index.html"
  },
  "dependencies": {
    "dompurify": "3.4.16",
    "katex": "0.19.0",
    "markdown-it": "15.0.2",
    "shiki": "4.5.0",
    "svelte": "5.57.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/katex": "0.16.8",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.4",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
